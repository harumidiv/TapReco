        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TapReco"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音にはマイクへのアクセス許可が必要です"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is needed to record audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 녹음하려면 마이크 접근 권한이 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音需要取得麥克風存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para grabar audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone é necessário para gravar áudio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon diperlukan untuk merekam audio."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音のタイトルを録音場所に設定するには許可が必要です"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access lets you use the recording location as its title."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 장소를 제목으로 사용하려면 위치 접근 권한이 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要以錄音地點作為標題，需要取得位置存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a tu ubicación permite usar el lugar de grabación como título."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização permite usar o local da gravação como título."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi memungkinkan lokasi rekaman digunakan sebagai judul."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの興味に合った広告を表示するために使用します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is used to show ads that match your interests."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사에 맞는 광고를 표시하는 데 사용됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的資料將用於顯示符合您興趣的廣告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se usan para mostrar anuncios según tus intereses."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são usados para mostrar anúncios de seu interesse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda digunakan untuk menampilkan iklan sesuai minat Anda."
          }
        }
      }
    }
  },
  "version": "1.0"
}
