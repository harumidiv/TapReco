    "ワンタッチですぐ録音!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタッチですぐ録音!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record with one tap!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하여 녹음!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一點即錄！"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Graba con un toque!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave com um toque!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam sekali ketuk!"
          }
        }
      }
    },
    "画面全体が録音開始ボタンです": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体が録音開始ボタンです"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anywhere on the screen to record."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 어디든 탭하면 녹음이 시작됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下螢幕任意位置即可開始錄音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la pantalla para empezar a grabar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tela para começar a gravar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di mana saja untuk mulai merekam."
          }
        }
      }
    },
    "ミスのない録音停止ボタン": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミスのない録音停止ボタン"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop with a slide"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 안전하게 정지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動即可停止錄音"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para detener"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para parar"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk berhenti"
          }
        }
      }
    },
    "ミスタッチがないように、\n録音停止ボタンはスライド式!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミスタッチがないように、\n録音停止ボタンはスライド式!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide to stop recording.\nAvoid accidental taps!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실수로 멈추지 않도록\n밀어서 녹음을 정지하세요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動按鈕停止錄音，\n避免誤觸！"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para detener la grabación\ny evitar toques accidentales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para parar a gravação\ne evitar toques acidentais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk menghentikan rekaman\nagar tidak terhenti karena salah ketuk."
          }
        }
      }
    },
