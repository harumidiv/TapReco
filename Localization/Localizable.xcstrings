    "ポケットの中でも誤って録音停止しません。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid stopping by accident in your pocket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita detener la grabación por error en el bolsillo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari rekaman terhenti akibat salah ketuk di saku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポケットの中でも誤って録音停止しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주머니 속에서도 실수로 멈추지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite parar a gravação por engano no bolso."
          }
        },
