  {
    "type": "appStoreVersionLocalizations",
    "id": "295c21fc-4ea0-4202-99d9-c84e4d6b94bd",
    "attributes": {
      "description": "Record discreetly with this app.\nWhether you face workplace bullying, sexual or emotional harassment, threats, or a crime, you can start recording by opening the app and tapping the screen once—even when you are under intense pressure or panicking.\nThe entire screen is the record button, so you won't miss it by tapping the wrong spot!\nThe stop button uses a sliding action, so you don't have to worry about accidentally stopping a recording midway.\n\n■ Recording\n- Unlimited recording time\n\n■ Playback\n- Rename files\n- Use your current location as the file name\n- Sort files\n- Skip forward 15 seconds during playback\n\n■ Other features\n- Share files\n",
      "locale": "en-US",
      "keywords": "voice memo,one tap,meeting,minutes,lecture,evidence,harassment,emergency,safety,discreet",
      "marketingUrl": "https://harumidiv.github.io/AppleStoreDevelopprSite/detail/tapreco.html",
      "promotionalText": null,
      "supportUrl": "https://harumidiv.github.io/AppleStoreDevelopprSite/",
